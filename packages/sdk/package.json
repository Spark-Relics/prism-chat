{
  "name": "@prism/sdk",
  "version": "0.1.0",
  "description": "Prism SDK — create a messaging hub in one line; registry-based pluggable channel adapters.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"fs.rmSync('dist',{force:true,recursive:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prism/core": "workspace:*",
    "@prism/adapter-telegram": "workspace:*",
    "@prism/adapter-email": "workspace:*",
    "@prism/adapter-whatsapp": "workspace:*",
    "@prism/adapter-line": "workspace:*",
    "@prism/adapter-telegram-user": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
