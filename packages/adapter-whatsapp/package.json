{
  "name": "@prism/adapter-whatsapp",
  "version": "0.1.0",
  "description": "Prism channel adapter skeleton for WhatsApp Cloud API.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"fs.rmSync('dist',{force:true,recursive:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prism/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
