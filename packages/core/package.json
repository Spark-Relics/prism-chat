{
  "name": "@prism/core",
  "version": "0.1.0",
  "description": "Prism core — channel-agnostic message model, adapter contract and reliable delivery pipeline.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"fs.rmSync('dist',{force:true,recursive:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types \"test/*.test.ts\""
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
