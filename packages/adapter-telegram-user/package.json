{
  "name": "@prism/adapter-telegram-user",
  "version": "0.1.0",
  "description": "Prism channel adapter for Telegram personal accounts (MTProto via GramJS userbot).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"fs.rmSync('dist',{force:true,recursive:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types \"test/*.test.ts\""
  },
  "dependencies": {
    "@prism/core": "workspace:*"
  },
  "peerDependencies": {
    "telegram": ">=2.16.0",
    "input": ">=0.1.3"
  },
  "peerDependenciesMeta": {
    "telegram": { "optional": true },
    "input": { "optional": true }
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
